# Données générées. Le CI régénère les indés à chaque déploiement, mais l'API
# Pathé bloque les IP datacenter du CI : on versionne donc la photo Pathé,
# collectée en local, pour que le build s'en serve (indés frais + Pathé figé).
data/*
!data/pathe_cinemas.json
!data/pathe_movies.json
!data/pathe_showtimes.json
!data/pathe_cities.json
!data/cgr_cinemas.json
!data/cgr_movies.json
!data/cgr_showtimes.json
!data/cgr_cities.json
!data/ugc_cinemas.json
!data/ugc_movies.json
!data/ugc_showtimes.json
!data/ugc_cities.json
!data/grandecran_cinemas.json
!data/grandecran_movies.json
!data/grandecran_showtimes.json
!data/grandecran_cities.json
# Salles indépendantes hors SCARE (fetch_salles.py) : mêmes raisons que les
# chaînes — sources privées, collecte locale, snapshot versionné pour que le
# build tienne même si le CI n'y accède pas.
!data/salles_cinemas.json
!data/salles_movies.json
!data/salles_showtimes.json
!data/salles_cities.json
!data/tmdb.json
# Snapshot SCARE (fetch_data.py) — les séances des cinémas indépendants.
# Le CI le régénère à chaque build ; s'il est versionné, c'est pour la panne
# du 2026-09-18 : un des 70 jeux enfants du jeu VIRTUEL « programmation-cinemas »
# a été supprimé côté SCARE sans être détaché, data-fair a répondu 501 à TOUTE
# requête, et le déploiement est mort avec la source — emportant au passage les
# snapshots frais des chaînes, qui n'avaient rien demandé. Même remède que pour
# les chaînes : on garde la dernière photo valide. Une panne de source gèle les
# séances indés au lieu de faire disparaître 145 cinémas du site.
!data/cinemas.json
!data/movies.json
!data/showtimes.json
!data/cities.json
!data/meta.json
# Cartes d'abonnement illimité : collectées par fetch_abonnements.py (2 requêtes,
# sources qui ne bougent que 2-3 fois par an) + corrections manuelles relues.
!data/abonnements.json
!data/abonnements_overrides.json
site/
# Redirections vers la nouvelle adresse, régénérées depuis le sitemap
# (scripts/build_redirects.py) — 3 500 fichiers, aucun intérêt à les versionner.
redirect/

__pycache__/
*.pyc
!data/letterboxd.json

# Rapport de fin de build : chaînes sans traduction anglaise (regénéré à chaque build)
i18n-manquantes.txt

# Cache local de wrangler (CLI Cloudflare)
.wrangler/
